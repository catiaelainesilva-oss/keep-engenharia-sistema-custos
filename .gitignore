from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Border, Side, Alignment
from openpyxl.utils import get_column_letter
from openpyxl.worksheet.datavalidation import DataValidation
from openpyxl.chart import BarChart, PieChart, LineChart
from openpyxl.chart.label import DataLabelList
from openpyxl.formatting.rule import CellIsRule
from io import BytesIO


def set_header(ws, title, subtitle=""):
    ws.merge_cells("A1:F1")
    ws["A1"] = title
    ws["A1"].font = Font(size=14, bold=True, color="FFFFFF")
    ws["A1"].fill = PatternFill("solid", fgColor="1F3552")
    ws["A1"].alignment = Alignment(horizontal="center")

    if subtitle:
        ws.merge_cells("A2:F2")
        ws["A2"] = subtitle
        ws["A2"].font = Font(italic=True, color="4F4F4F")
        ws["A2"].alignment = Alignment(horizontal="center")


def style_table(ws, headers, start_row=5, start_col=1):
    header_fill = PatternFill("solid", fgColor="D9EAF7")
    header_font = Font(bold=True, color="1F1F1F")
    thin = Side(style="thin", color="D0D0D0")
    border = Border(left=thin, right=thin, top=thin, bottom=thin)

    for col in range(start_col, start_col + len(headers)):
        cell = ws.cell(row=start_row, column=col)
        cell.value = headers[col - start_col]
        cell.font = header_font
        cell.fill = header_fill
        cell.border = border
        cell.alignment = Alignment(horizontal="center", vertical="center")

    for row in range(start_row + 1, ws.max_row + 1):
        for col in range(start_col, start_col + len(headers)):
            cell = ws.cell(row=row, column=col)
            cell.border = border


def add_table(ws, headers, rows, start_row=5, start_col=1):
    for row_idx, row in enumerate(rows, start=start_row + 1):
        for col_idx, value in enumerate(row, start=start_col):
            ws.cell(row=row_idx, column=col_idx, value=value)
    style_table(ws, headers, start_row, start_col)

    # freeze panes and auto width
    ws.freeze_panes = "A6"
    for col_idx, header in enumerate(headers, start=start_col):
        max_len = max(len(str(cell.value)) if cell.value is not None else 0 for cell in ws.iter_cols(min_col=col_idx, max_col=col_idx, min_row=1, max_row=ws.max_row))
        ws.column_dimensions[get_column_letter(col_idx)].width = min(max_len + 2, 22)


def build_config_sheet(wb):
    ws = wb.active
    ws.title = "03 - CONFIGURAÇÕES"
    set_header(ws, "KEEP ENGENHARIA", "Parâmetros gerais do sistema")
    ws["A4"] = "Campo"
    ws["B4"] = "Valor"
    ws["C4"] = "Observações"
    ws["A4"].font = Font(bold=True)
    ws["B4"].font = Font(bold=True)
    ws["C4"].font = Font(bold=True)

    rows = [
        ("Nome da empresa", "KEEP Engenharia", ""),
        ("Regime tributário", "Simples Nacional", ""),
        ("Carga tributária estimada", "10%", "Editar conforme contabilidade"),
        ("Margem mínima desejada", "15%", ""),
        ("Margem recomendada", "20%", ""),
        ("Horas produtivas padrão/mês", "160", "Definir por equipe"),
        ("Percentual de perdas de materiais", "5%", ""),
        ("Percentual de custos indiretos", "15%", ""),
        ("Percentual padrão de contingência", "8%", ""),
        ("Meta de faturamento mensal", "R$ 250.000,00", ""),
        ("Meta de lucro mensal", "R$ 35.000,00", ""),
        ("Km médio mensal", "1.500", ""),
        ("Observações", "Os parâmetros tributários devem ser validados com a contabilidade da empresa.", ""),
    ]
    for i, row in enumerate(rows, start=5):
        for j, value in enumerate(row, start=1):
            ws.cell(row=i, column=j, value=value)

    ws["A18"] = "Aviso:"
    ws["A18"].font = Font(bold=True, color="B22222")
    ws["A19"] = "Os parâmetros tributários devem ser validados com a contabilidade da empresa."
    ws["A19"].font = Font(color="B22222")
    ws.freeze_panes = "A5"
    ws.column_dimensions["A"].width = 28
    ws.column_dimensions["B"].width = 24
    ws.column_dimensions["C"].width = 36


def build_people_sheet(wb):
    ws = wb.create_sheet("04 - PESSOAS")
    set_header(ws, "KEEP ENGENHARIA", "Cadastro de profissionais")
    headers = [
        "ID", "Nome", "Função", "Tipo", "Regime", "Custo mensal", "Encargos", "Benefícios", "Outros custos",
        "Custo total mensal", "Horas disponíveis", "Horas improdutivas", "Horas produtivas", "Custo hora produtiva", "Observações"
    ]
    rows = [
        [1, "João Silva", "Engenheiro", "Engenheiro", "CLT", 9000, 2000, 500, 300, 11800, 220, 30, 190, 62.11, ""],
        [2, "Maria Souza", "Mestre de obras", "Mestre de obras", "CLT", 6500, 1800, 350, 200, 8850, 220, 35, 185, 47.84, ""],
        [3, "Carlos Lima", "Pedreiro", "Pedreiro", "CLT", 4200, 1200, 250, 150, 5800, 220, 25, 195, 29.74, ""],
    ]
    add_table(ws, headers, rows)
    ws["K5"] = ""  # placeholder to keep structure sensible

    # formulas
    for row in range(6, 9):
        ws[f("J{row}")] = f"=F{row}+G{row}+H{row}+I{row}"
        ws[f("N{row}")] = f"=J{row}/M{row}"


