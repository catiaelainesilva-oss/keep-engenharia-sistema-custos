    for row in range(6, 9):
        ws[f("Q{row}")] = f"=F{row}-M{row}"
        ws[f("R{row}")] = f"=(F{row}-M{row})/F{row}"
        ws[f("S{row}")] = f"=(F{row}-O{row})/F{row}"


