def build_dashboard_sheet(wb):
    ws = wb.create_sheet("01 - DASHBOARD")
    ws.title = "01 - DASHBOARD"
    set_header(ws, "KEEP ENGENHARIA", "Dashboard executivo")

    cards = [
        ("FATURAMENTO", "R$ 420.000"),
        ("CUSTOS DIRETOS", "R$ 258.000"),
        ("LUCRO BRUTO", "R$ 162.000"),
        ("DESPESAS", "R$ 74.000"),
        ("LUCRO LÍQUIDO", "R$ 88.000"),
        ("MARGEM LÍQUIDA", "21%"),
    ]
    for idx, (label, value) in enumerate(cards):
        row = 5 + (idx // 3) * 3
        col = 2 + (idx % 3) * 3
        ws.cell(row=row, column=col, value=label)
        ws.cell(row=row + 1, column=col, value=value)
        ws.cell(row=row, column=col).font = Font(bold=True, color="FFFFFF")
        ws.cell(row=row, column=col).fill = PatternFill("solid", fgColor="1F3552")
        ws.cell(row=row + 1, column=col).font = Font(size=14, bold=True)
        ws.cell(row=row + 1, column=col).fill = PatternFill("solid", fgColor="EAF2F8")
        ws.merge_cells(start_row=row, start_column=col, end_row=row, end_column=col + 1)
        ws.merge_cells(start_row=row + 1, start_column=col, end_row=row + 1, end_column=col + 1)

    # chart: Receita x Custos x Lucro
    chart = BarChart()
    chart.title = "Receita x Custos x Lucro"
    data = ["Receita", "Custo", "Lucro"]
    chart_data = [
        ["Jan", "Fev", "Mar", "Abr", "Mai", "Jun"],
        [300000, 340000, 390000, 420000, 460000, 500000],
        [180000, 210000, 240000, 258000, 278000, 295000],
        [120000, 130000, 150000, 162000, 182000, 205000],
    ]
    # simplified placeholder chart using existing values will be set below
    ws["A18"] = "Dados da série"
    ws["A19"] = "Mês"
    ws["B19"] = "Receita"
    ws["C19"] = "Custos"
    ws["D19"] = "Lucro"
    meses = ["Jan", "Fev", "Mar", "Abr", "Mai", "Jun"]
    rows_data = [
        ["Jan", 300000, 180000, 120000],
        ["Fev", 340000, 210000, 130000],
        ["Mar", 390000, 240000, 150000],
        ["Abr", 420000, 258000, 162000],
        ["Mai", 460000, 278000, 182000],
        ["Jun", 500000, 295000, 205000],
    ]
    for i, row in enumerate(rows_data, start=20):
        for j, value in enumerate(row, start=1):
            ws.cell(row=i, column=j, value=value)
    chart = BarChart()
    chart.title = "Receita x Custos x Lucro"
    chart.y_axis.title = "R$"
    chart.x_axis.title = "Mês"
    data = ws["B20:D25"]
    chart.add_data(data, titles_from_data=True)
    chart.set_categories(ws["A20:A25"])
    ws.add_chart(chart, "H20")

    pie = PieChart()
    pie.title = "Participação por categoria"
    pie_data = ["Mão de obra", "Materiais", "Terceiros", "Combustível", "Equipamentos", "Despesas administrativas", "Impostos", "Outros"]
    pie_values = [120000, 60000, 30000, 14000, 18000, 42000, 15000, 12000]
    ws["H5"] = "Participação por categoria"
    for i, (label, value) in enumerate(zip(pie_data, pie_values), start=2):
        ws[f"H{i}"] = label
        ws[f"I{i}"] = value
    pie_data_ref = ws["I2:I9"]
    pie_cat_ref = ws["H2:H9"]
    pie.add_data(pie_data_ref, titles_from_data=False)
    pie.set_categories(pie_cat_ref)
    pie.height = 7
    pie.width = 9
    ws.add_chart(pie, "N20")

    ws["A35"] = "RAIO-X DA EMPRESA — ONDE O DINHEIRO ESTÁ INDO?"
    ws["A35"].font = Font(bold=True)
    ws["A36"] = "Mão de obra"
    ws["B36"] = 120000
    ws["A37"] = "Materiais"
    ws["B37"] = 60000
    ws["A38"] = "Terceiros"
    ws["B38"] = 30000
    ws["A39"] = "Combustível"
    ws["B39"] = 14000
    ws["A40"] = "Equipamentos"
    ws["B40"] = 18000
    ws["A41"] = "Despesas administrativas"
    ws["B41"] = 42000
    ws["A42"] = "Impostos"
    ws["B42"] = 15000
    ws["A43"] = "Outros"
    ws["B43"] = 12000


def build_instruction_sheet(wb):
    ws = wb.create_sheet("02 - INSTRUÇÕES")
    set_header(ws, "KEEP ENGENHARIA", "Como usar o sistema")
    instructions = [
        "1. O que cadastrar primeiro: empresa, configurações, clientes, pessoas, veículos, equipamentos e obras.",
        "2. Como cadastrar pessoas: informe nome, função, custo mensal, encargos e horas produtivas reais.",
        "3. Como calcular custo/hora: custo total mensal dividido pelas horas produtivas reais.",
        "4. Como cadastrar veículos: informe preço do combustível, manutenção, pneus, seguro, IPVA e depreciação por km.",
        "5. Como calcular custo/km: soma dos itens por km.",
        "6. Como cadastrar equipamentos: informe aquisição, vida útil, horas estimadas e custos de manutenção.",
        "7. Como criar uma obra: cadastre o cliente, descreva o serviço, o valor contratado e o status.",
        "8. Como fazer orçamento: use a aba ORÇAMENTO e defina custos por categoria.",
        "9. Como lançar custos: registre os custos em LANÇAMENTOS com categoria e status financeiro.",
        "10. Como lançar receitas: registre receitas em LANÇAMENTOS com tipo Receita.",
        "11. Como registrar despesas: utilize a aba DESPESAS para custos indiretos, impostos e fixos.",
        "12. Como analisar margem: compare o valor contratado com os custos realizados e projetados.",
        "13. Como usar o Dashboard: acompanhe faturamento, custos, margem e alertas.",
        "14. Como identificar prejuízo: compare custo e receita por obra e pela DRE.",
        "15. Como identificar onde o dinheiro está indo: analise as categorias no dashboard e nos indicadores.",
        "Exemplo fictício: uma obra de reforma recebeu R$ 85.000, teve custo real de R$ 60.000 e gerou margem de 29%.",
        "Exemplo fictício: uma obra de consultoria teve custo previsto de R$ 26.000 e faturamento de R$ 35.000, gerando margem saudável.",
        "Exemplo fictício: uma obra com custo projetado acima do contrato deve ser sinalizada como risco ou prejuízo no dashboard.",
    ]
    for idx, text in enumerate(instructions, start=5):
        ws[f"A{idx}"] = text
        ws[f"A{idx}"].alignment = Alignment(wrap_text=True)
    ws.column_dimensions["A"].width = 140
    ws.freeze_panes = "A5"


def generate_workbook(file_name="KEEP_Sistema_Executivo_Custos_v1.xlsx"):
    wb = Workbook()
    build_dashboard_sheet(wb)
    build_instruction_sheet(wb)
    build_config_sheet(wb)
    build_people_sheet(wb)
    build_vehicles_sheet(wb)
    build_equipment_sheet(wb)
    build_clients_sheet(wb)
    build_works_sheet(wb)
    build_budget_sheet(wb)
    build_launches_sheet(wb)
    build_expenses_sheet(wb)
    build_pricing_sheet(wb)
    build_dre_sheet(wb)
    build_cashflow_sheet(wb)
    build_indicators_sheet(wb)
    build_cadastros_sheet(wb)

    # Remove default sheet if created
    default_sheet = wb["Sheet"]
    if default_sheet is not None:
        wb.remove(default_sheet)

    # Save to memory
    stream = BytesIO()
    wb.save(stream)
    stream.seek(0)
    return stream.getvalue()


if __name__ == "__main__":
    data = generate_workbook()
    with open("KEEP_Sistema_Executivo_Custos_v1.xlsx", "wb") as f:
        f.write(data)
        print("Arquivo Excel criado: KEEP_Sistema_Executivo_Custos_v1.xlsx")
