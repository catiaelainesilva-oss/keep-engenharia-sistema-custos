        "Custo comprometido", "Custo projetado", "Lucro bruto", "Margem atual", "Margem projetada", "Situação financeira", "Observações"
    ]
    rows = [
        [1, "K-001", "Residencial Alfa", "Reforma", "Reforma de cozinha e área de serviço", 85000, "2025-01-15", "2025-01-20", "2025-03-15", "", "Em andamento", 62000, 41000, 15000, 61000, "=F6-N6", "=(F6-M6)/F6", "=(F6-O6)/F6", "Saudável", ""],
        [2, "K-002", "Empresa Beta Ltda", "Obra", "Ampliação de sede comercial", 180000, "2025-02-03", "2025-02-10", "2025-06-30", "", "Em andamento", 150000, 98000, 35000, 145000, "=F7-N7", "=(F7-M7)/F7", "=(F7-O7)/F7", "Atenção", ""],
